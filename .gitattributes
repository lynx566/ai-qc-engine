* text=auto

# Keep code and config deterministic across platforms.
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Windows-native scripts keep CRLF where useful.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf