        "min_table_blocks": 0,
        "min_format_blocks": 0,
        "expected_text_terms": [
          "摘要",
          "前言",
          "临床安全性",
          "不良反应"
        ],
        "expected_table_ref_terms": [
          "表1"
        ]
      }
    },
